    <string name="bottom_sheet_shizuku_not_running_title">Shizuku не запущено</string>
    <string name="bottom_sheet_shizuku_not_running_content">Shizuku встановлено, але службу не запущено. Відкрийте Shizuku та запустіть службу через ADB, щоб продовжити.</string>
