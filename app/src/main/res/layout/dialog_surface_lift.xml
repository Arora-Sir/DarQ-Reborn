<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/padding_24"
    android:paddingTop="@dimen/padding_8"
    android:paddingEnd="@dimen/padding_24"
    android:paddingBottom="@dimen/padding_8">

    <TextView
        android:id="@+id/surface_lift_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/appearance_pure_black_lift_hint"
        android:textAppearance="@style/TextAppearance.AppCompat.Small.Darq"
        android:textColor="?android:textColorSecondary" />

    <!-- NOTE: The value line has a fixed height so nothing below it moves when the text changes between the short and the long label. -->
    <TextView
        android:id="@+id/surface_lift_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_16"
        android:gravity="center"
        android:minHeight="32dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium.Darq"
        tools:ignore="MissingPrefix"
        xmlns:tools="http://schemas.android.com/tools"
        tools:text="Level 5 of 10, recommended" />

    <com.google.android.material.slider.Slider
        android:id="@+id/surface_lift_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/appearance_pure_black_lift_title"
        android:stepSize="10"
        android:valueFrom="0"
        android:valueTo="100" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/surface_lift_reset"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_8"
        android:minHeight="48dp"
        android:text="@string/appearance_pure_black_lift_reset"
        android:textAllCaps="false" />

</LinearLayout>
