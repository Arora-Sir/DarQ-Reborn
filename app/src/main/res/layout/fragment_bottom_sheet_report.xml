<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:layout_gravity="bottom">

    <TextView
        android:id="@+id/report_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_24"
        android:layout_marginTop="@dimen/padding_16"
        android:layout_marginEnd="@dimen/padding_8"
        android:paddingTop="@dimen/padding_8"
        android:paddingBottom="@dimen/padding_8"
        android:text="@string/diagnostics_report_title"
        android:textAppearance="@style/TextAppearance.AppCompat.Large.Darq"
        app:layout_constraintEnd_toStartOf="@id/report_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/report_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="@dimen/padding_16"
        android:background="@drawable/rounded_ripple_36"
        android:contentDescription="@string/diagnostics_report_close"
        android:src="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="@id/report_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/report_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/report_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_8"
        android:scrollIndicators="top|bottom"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/report_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="440dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/report_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_16"
            android:paddingTop="@dimen/padding_8"
            android:paddingEnd="@dimen/padding_16"
            android:paddingBottom="@dimen/padding_8">

            <ProgressBar
                android:id="@+id/report_loading"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="@dimen/padding_24" />

            <LinearLayout
                android:id="@+id/report_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/report_card_summary"
                    style="@style/Darq.ReportCard">

                    <TextView
                        style="@style/Darq.ReportCardTitle"
                        android:text="@string/diagnostics_report_summary" />

                    <TextView
                        android:id="@+id/report_summary"
                        style="@style/Darq.ReportCardBody" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/report_card_crash"
                    style="@style/Darq.ReportCard">

                    <TextView
                        style="@style/Darq.ReportCardTitle"
                        android:text="@string/diagnostics_report_last_crash" />

                    <TextView
                        android:id="@+id/report_crash"
                        style="@style/Darq.ReportCardBody" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/report_card_handled"
                    style="@style/Darq.ReportCard">

                    <TextView
                        style="@style/Darq.ReportCardTitle"
                        android:text="@string/diagnostics_report_handled" />

                    <TextView
                        android:id="@+id/report_handled"
                        style="@style/Darq.ReportCardBody" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/report_card_log"
                    style="@style/Darq.ReportCard">

                    <TextView
                        android:id="@+id/report_log_hint"
                        style="@style/Darq.ReportCardBody"
                        android:text="@string/diagnostics_report_log_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/report_toggle_log"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-12dp"
                        android:fontFamily="@font/google_sans_text_medium"
                        android:text="@string/diagnostics_report_show_log"
                        android:textAllCaps="false" />

                    <TextView
                        android:id="@+id/report_log"
                        style="@style/Darq.ReportCardBody"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/report_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_16"
        android:paddingTop="@dimen/padding_8"
        android:paddingEnd="@dimen/padding_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/report_scroll">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/report_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:fontFamily="@font/google_sans_text_medium"
            android:minHeight="48dp"
            android:text="@string/diagnostics_report_github"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/report_more"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:fontFamily="@font/google_sans_text_medium"
            android:minHeight="48dp"
            android:text="@string/diagnostics_report_more"
            android:textAllCaps="false" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
