<?xml version="1.0" encoding="utf-8"?>
<!-- NOTE: The main switch is a full-width bar that turns the accent container color when DarQ is on, like the Android settings main switch. -->
<com.google.android.material.materialswitch.MaterialSwitch xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/mainSwitchSwitch"
    android:minHeight="@dimen/main_switch_min_height"
    android:layout_marginStart="@dimen/padding_16"
    android:layout_marginEnd="@dimen/padding_16"
    android:layout_marginTop="@dimen/padding_8"
    android:layout_marginBottom="@dimen/padding_8"
    android:paddingStart="@dimen/padding_24"
    android:paddingEnd="@dimen/padding_16"
    android:background="@drawable/main_switch_background"
    android:textAppearance="@style/TextAppearance.AppCompat.Large.Darq"
    android:textColor="@color/main_switch_text"
    android:text="@string/item_switch_main_title" />
