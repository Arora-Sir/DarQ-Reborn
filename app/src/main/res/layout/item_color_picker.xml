<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_color_picker_tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:paddingTop="@dimen/padding_8"
        android:paddingBottom="@dimen/padding_8">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <!-- NOTE: The dot, its outline, an optional icon and the tick badge sit in one 48dp box. -->
            <View
                android:id="@+id/item_color_picker_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/monet_color_picker_circle_background"
                android:importantForAccessibility="no"
                tools:backgroundTint="@color/material_on_primary_disabled" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/color_swatch_outline"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/item_color_picker_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wallpaper"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/item_color_picker_check"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/color_tile_badge"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                tools:visibility="visible" />

        </FrameLayout>

        <TextView
            android:id="@+id/item_color_picker_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="2"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Small.Darq"
            android:textColor="?android:textColorPrimary"
            tools:text="Teal" />

    </LinearLayout>

</FrameLayout>
