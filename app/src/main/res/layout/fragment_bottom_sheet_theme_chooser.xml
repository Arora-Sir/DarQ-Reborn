<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/padding_20"
    android:paddingTop="@dimen/padding_12"
    android:paddingEnd="@dimen/padding_20"
    android:paddingBottom="@dimen/padding_20"
    tools:layout_gravity="bottom">

    <!-- Top Drag Handle -->
    <View
        android:id="@+id/theme_chooser_drag_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:alpha="0.4"
        android:background="@drawable/bottom_sheet_drag_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title Header -->
    <TextView
        android:id="@+id/theme_chooser_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_16"
        android:text="@string/appearance_theme_title"
        android:textAppearance="@style/TextAppearance.AppCompat.Large.Darq"
        android:textColor="?android:textColorPrimary"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/theme_chooser_drag_handle" />

    <LinearLayout
        android:id="@+id/theme_chooser_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_16"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/theme_chooser_title">

        <!-- System Theme Option -->
        <LinearLayout
            android:id="@+id/theme_card_system"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button_background_backup_restore"
            android:foreground="@drawable/rounded_ripple_36"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:padding="@dimen/padding_16"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/theme_ic_system"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_system_theme" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/theme_title_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/appearance_theme_system"
                    android:textAppearance="@style/TextAppearance.AppCompat.Medium.Darq"
                    android:textColor="?android:textColorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/theme_summary_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/appearance_theme_system_summary"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small.Darq"
                    android:textColor="?android:textColorSecondary" />
            </LinearLayout>

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/theme_radio_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />

        </LinearLayout>

        <!-- Light Theme Option -->
        <LinearLayout
            android:id="@+id/theme_card_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_8"
            android:background="@drawable/button_background_backup_restore"
            android:foreground="@drawable/rounded_ripple_36"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:padding="@dimen/padding_16"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/theme_ic_light"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_sun" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/theme_title_light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/appearance_theme_light"
                    android:textAppearance="@style/TextAppearance.AppCompat.Medium.Darq"
                    android:textColor="?android:textColorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/theme_summary_light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/appearance_theme_light_summary"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small.Darq"
                    android:textColor="?android:textColorSecondary" />
            </LinearLayout>

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/theme_radio_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />

        </LinearLayout>

        <!-- Dark Theme Option -->
        <LinearLayout
            android:id="@+id/theme_card_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_8"
            android:background="@drawable/button_background_backup_restore"
            android:foreground="@drawable/rounded_ripple_36"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:padding="@dimen/padding_16"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/theme_ic_dark"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_night" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/theme_title_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/appearance_theme_dark"
                    android:textAppearance="@style/TextAppearance.AppCompat.Medium.Darq"
                    android:textColor="?android:textColorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/theme_summary_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/appearance_theme_dark_summary"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small.Darq"
                    android:textColor="?android:textColorSecondary" />
            </LinearLayout>

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/theme_radio_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />

        </LinearLayout>

    </LinearLayout>

    <!-- Full-width Symmetrical Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/theme_chooser_cancel"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/padding_16"
        android:fontFamily="@font/google_sans_text_medium"
        android:text="@android:string/cancel"
        android:textAllCaps="false"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/theme_chooser_container" />

</androidx.constraintlayout.widget.ConstraintLayout>
