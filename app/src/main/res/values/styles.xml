<resources>

    <!-- NOTE: Accent roles come from a ThemeOverlay.Darq.Accent overlay or from dynamic colors, applied by ThemeManager before the activity inflates. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="searchBoxBackground">@color/search_box_background</item>
        <item name="textAppearanceLargePopupMenu">@style/AppTheme.TextAppearance.Popup</item>
        <item name="actionOverflowMenuStyle">@style/DarqOverflowMenu</item>
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Darq.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Darq.MaterialAlertDialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Darq.FrameworkAlertDialog</item>
    </style>

    <!-- NOTE: Every dialog gets its look from these styles through the app theme, never per dialog. -->
    <!-- NOTE: Material 3 supplies the 28dp surfaceContainerHigh window, and these add the title font and sentence case primary buttons. -->
    <!-- NOTE: Nothing here points a framework attribute at an app attribute, which would fail to resolve inside the dialog title. -->
    <style name="ThemeOverlay.Darq.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Darq.Title.Text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Darq.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Darq.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Darq.DialogButton</item>
    </style>

    <style name="MaterialAlertDialog.Darq.Title.Text" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/google_sans_text_medium</item>
    </style>

    <style name="Widget.Darq.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/google_sans_text_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- NOTE: The framework alert dialog theme is for any android.app.AlertDialog, so no dialog keeps the platform look. -->
    <style name="Theme.Darq.FrameworkAlertDialog" parent="Theme.Material3.DayNight.Dialog.Alert" />

    <!-- NOTE: Pure black for AMOLED screens, applied on top of the accent only while the app is dark. -->
    <!-- NOTE: Containers keep small steps above black so cards and sheets stay distinguishable. -->
    <style name="ThemeOverlay.Darq.PureBlack" parent="">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorSurfaceDim">@android:color/black</item>
        <item name="colorSurfaceContainerLowest">@android:color/black</item>
        <item name="colorSurfaceContainerLow">#FF0B0B0C</item>
        <item name="colorSurfaceContainer">#FF121214</item>
        <item name="colorSurfaceContainerHigh">#FF1A1A1D</item>
        <item name="colorSurfaceContainerHighest">#FF232327</item>
    </style>

    <style name="TextAppearance.AppCompat.Small.Darq" parent="TextAppearance.AppCompat.Small">
        <item name="android:fontFamily">@font/google_sans_text</item>
    </style>

    <style name="TextAppearance.AppCompat.Small.Darq.Medium" parent="TextAppearance.AppCompat.Small">
        <item name="android:fontFamily">@font/google_sans_text</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.AppCompat.Medium.Darq" parent="TextAppearance.AppCompat.Medium">
        <item name="android:fontFamily">@font/google_sans_text</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.AppCompat.Large.Darq" parent="TextAppearance.AppCompat.Large">
        <item name="android:fontFamily">@font/google_sans_text</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.AppCompat.Large.Darq.Lighter" parent="TextAppearance.AppCompat.Large.Darq">
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="BaseBottomSheetDialog" parent="@style/ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/BottomSheet</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="BaseBottomSheetDialog.Dark" parent="@style/ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/BottomSheet.Dark</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="BottomSheet" parent="@style/Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_rounded_bg</item>
    </style>

    <style name="BottomSheet.Dark" parent="@style/Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_rounded_bg_dark</item>
    </style>

    <style name="AppTheme.TextAppearance.Popup" parent="TextAppearance.AppCompat.Widget.TextView.SpinnerItem">
        <item name="fontFamily">@font/google_sans_text</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

    <style name="DarqOverflowMenu" parent="@style/Widget.Material3.PopupMenu.Overflow" />

    <style name="AppTheme.ThirdPartyLicences" parent="Theme.Material3.DayNight">
        <item name="actionBarStyle">@style/ThirdPartyLicencesToolbarTheme</item>
        <item name="android:statusBarColor">?android:windowBackground</item>
        <item name="android:windowLightStatusBar">@bool/lightStatusNav</item>
        <item name="android:textViewStyle">@style/ThirdPartyLicencesTextViewStyle</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowAnimationStyle">@style/ThirdPartyLicencesActivityAnimation</item>
    </style>

    <style name="ThirdPartyLicencesActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="ThirdPartyLicencesToolbarTheme" parent="@style/Widget.AppCompat.Light.ActionBar.Solid">
        <item name="background">?android:windowBackground</item>
        <item name="titleTextStyle">@style/ThirdPartyLicencesToolbarTitleStyle</item>
        <item name="colorControlNormal">?attr/colorOnSurface</item>
        <item name="homeAsUpIndicator">@drawable/ic_back</item>
    </style>

    <style name="ThirdPartyLicencesToolbarTitleStyle" parent="@style/TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/google_sans_text_medium</item>
    </style>

    <style name="ThirdPartyLicencesTextViewStyle" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/google_sans_text</item>
    </style>

    <!-- Report preview cards -->
    <style name="Darq.ReportCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/padding_8</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/padding_16</item>
        <item name="android:background">@drawable/button_background_backup_restore</item>
    </style>

    <style name="Darq.ReportCardTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/padding_8</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Medium.Darq</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Darq.PickerSection" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">@dimen/padding_16</item>
        <item name="android:paddingBottom">@dimen/padding_8</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Small.Darq.Medium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Darq.ReportCardBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Small.Darq</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

</resources>
