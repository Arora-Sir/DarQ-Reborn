<?xml version="1.0" encoding="utf-8"?>
<!-- NOTE: Crash reports stay on the device that produced them, everything else keeps the default backup and transfer behavior. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="diagnostics/" />
        <exclude domain="sharedpref" path="darq_diagnostics.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="diagnostics/" />
        <exclude domain="sharedpref" path="darq_diagnostics.xml" />
    </device-transfer>
</data-extraction-rules>
